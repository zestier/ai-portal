{
  "name": "zap",
  "version": "0.3.1",
  "private": true,
  "type": "module",
  "description": "Self-hosted web portal for the pi coding agent SDK.",
  "files": [
    "build",
    "src/lib/server/db/migrations",
    "README.md"
  ],
  "scripts": {
    "dev": "vite dev",
    "dev:isolated": "node scripts/dev-isolated.mjs",
    "build": "wireit",
    "preview": "vite preview",
    "start": "node build",
    "serve": "node scripts/serve.mjs",
    "check": "wireit",
    "check:watch": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --watch",
    "lint": "wireit",
    "format": "prettier --write .",
    "test": "wireit",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "test:e2e": "pnpm run build && pnpm run test:e2e:run",
    "test:e2e:install": "playwright install --with-deps firefox",
    "test:e2e:run": "pnpm run test:e2e:install && playwright test",
    "test:e2e:ui": "pnpm run build && playwright test --ui",
    "bench:conversation-load": "node scripts/bench-conversation-load.mjs",
    "report:adversary-shadow": "node scripts/adversary-shadow-report.mjs",
    "probe:adversary": "node scripts/adversary-probe.mjs",
    "verify": "wireit",
    "release:pack": "node scripts/pack-release.mjs",
    "prepare": "node scripts/install-git-hooks.mjs"
  },
  "dependencies": {
    "@earendil-works/pi-coding-agent": "0.84.4",
    "better-sqlite3": "13.0.3",
    "diff": "^9.0.0",
    "dompurify": "^3.4.14",
    "extract-zip": "^2.0.1",
    "highlight.js": "^11.12.0",
    "jsdom": "^30.0.1",
    "marked": "^18.0.11",
    "ripgrep": "0.3.1",
    "shell-quote": "^1.10.0",
    "smol-toml": "^1.8.0",
    "ulid": "^3.0.2",
    "zod": "^4.5.4"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@playwright/cli": "^0.1.18",
    "@playwright/test": "^1.62.1",
    "@sveltejs/adapter-node": "^5.5.7",
    "@sveltejs/kit": "^2.70.3",
    "@sveltejs/vite-plugin-svelte": "^6.2.4",
    "@types/better-sqlite3": "^9.6.0",
    "@types/diff": "^8.0.0",
    "@types/jsdom": "^30.0.0",
    "@types/node": "^26.4.0",
    "@types/shell-quote": "^1.7.5",
    "@vitest/coverage-v8": "4.1.11",
    "eslint": "^10.9.1",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-svelte": "^3.23.0",
    "globals": "^17.11.0",
    "prettier": "^3.9.6",
    "prettier-plugin-svelte": "^4.1.1",
    "svelte": "^5.57.0",
    "svelte-check": "^4.7.6",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.68.0",
    "vite": "^6.4.3",
    "vitest": "4.1.11",
    "wireit": "^0.14.13"
  },
  "engines": {
    "node": ">=24",
    "pnpm": ">=11"
  },
  "wireit": {
    "lint": {
      "command": "eslint . && prettier --check .",
      "files": [
        "eslint.config.js",
        ".prettierrc",
        ".prettierignore",
        "svelte.config.js",
        "vite.config.ts",
        "tsconfig.json",
        "src/",
        "scripts/",
        "tests/",
        "e2e/",
        "static/"
      ],
      "output": []
    },
    "test": {
      "command": "vitest run",
      "files": [
        "vite.config.ts",
        "tsconfig.json",
        "src/",
        "tests/"
      ],
      "output": []
    },
    "build": {
      "command": "vite build",
      "files": [
        "svelte.config.js",
        "vite.config.ts",
        "tsconfig.json",
        "src/",
        "static/"
      ],
      "output": [
        "build/"
      ]
    },
    "check": {
      "command": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --fail-on-warnings",
      "dependencies": [
        "build"
      ],
      "files": [
        "svelte.config.js",
        "vite.config.ts",
        "tsconfig.json",
        "src/"
      ],
      "output": []
    },
    "e2e": {
      "command": "pnpm run test:e2e:run",
      "dependencies": [
        "build"
      ],
      "files": [
        "playwright.config.ts",
        "e2e/"
      ],
      "output": [
        "test-results/",
        "playwright-report/"
      ],
      "env": {
        "E2E_ISOLATED": "1"
      }
    },
    "verify": {
      "dependencies": [
        "lint",
        "check",
        "e2e",
        "test"
      ]
    }
  },
  "packageManager": "pnpm@11.20.0"
}
