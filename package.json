{
	"name": "zap",
	"version": "0.1.0",
	"private": true,
	"type": "module",
	"description": "Self-hosted web portal for the GitHub Copilot agent SDK.",
	"files": [
		"build",
		"src/lib/server/db/migrations",
		"README.md"
	],
	"scripts": {
		"dev": "vite dev",
		"dev:isolated": "node scripts/dev-isolated.mjs",
		"build": "vite build",
		"preview": "vite preview",
		"start": "node build",
		"serve": "node scripts/serve.mjs",
		"check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
		"check:watch": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --watch",
		"lint": "eslint . && prettier --check .",
		"format": "prettier --write .",
		"test": "vitest run",
		"test:watch": "vitest",
		"test:coverage": "vitest run --coverage",
		"test:e2e": "pnpm run build && pnpm run test:e2e:run",
		"test:e2e:install": "playwright install --with-deps firefox",
		"test:e2e:run": "pnpm run test:e2e:install && playwright test",
		"test:e2e:ui": "pnpm run build && playwright test --ui",
		"bench:conversation-load": "node scripts/bench-conversation-load.mjs",
		"report:adversary-shadow": "node scripts/adversary-shadow-report.mjs",
		"capture:tool-golden": "node scripts/capture-tool-golden.mjs",
		"probe:adversary": "node scripts/adversary-probe.mjs",
		"verify": "node scripts/verify.mjs",
		"verify:sequential": "node scripts/verify.mjs --concurrency 1",
		"verify:failure-probe": "node scripts/verify.mjs --failure-probe",
		"release:bump-actions": "node scripts/bump-actions.mjs",
		"prepare": "node scripts/install-git-hooks.mjs"
	},
	"dependencies": {
		"@anthropic-ai/claude-agent-sdk": "0.3.224",
		"@earendil-works/pi-coding-agent": "0.84.1",
		"@github/copilot-sdk": "1.0.8",
		"better-sqlite3": "12.10.0",
		"diff": "^7.0.0",
		"dompurify": "^3.1.7",
		"extract-zip": "^2.0.1",
		"highlight.js": "^11.11.1",
		"jsdom": "^30.0.1",
		"marked": "^14.1.3",
		"ripgrep": "0.3.1",
		"shell-quote": "^1.8.3",
		"smol-toml": "^1.7.1",
		"ulid": "^2.3.0",
		"zod": "^3.23.8"
	},
	"devDependencies": {
		"@eslint/js": "^10.0.1",
		"@playwright/cli": "^0.1.14",
		"@playwright/test": "^1.48.0",
		"@sveltejs/adapter-node": "^5.2.0",
		"@sveltejs/kit": "^2.7.0",
		"@sveltejs/vite-plugin-svelte": "^4.0.0",
		"@types/better-sqlite3": "^7.6.11",
		"@types/diff": "^6.0.0",
		"@types/jsdom": "^28.0.3",
		"@types/node": "^22.7.0",
		"@types/shell-quote": "^1.7.5",
		"@vitest/coverage-v8": "2.1.9",
		"eslint": "^9.12.0",
		"eslint-config-prettier": "^9.1.0",
		"eslint-plugin-svelte": "^2.45.0",
		"globals": "^17.6.0",
		"prettier": "^3.3.3",
		"prettier-plugin-svelte": "^3.2.7",
		"svelte": "^5.0.0",
		"svelte-check": "^4.0.5",
		"typescript": "^5.6.3",
		"typescript-eslint": "^8.8.0",
		"vite": "^5.4.8",
		"vitest": "^2.1.2"
	},
	"engines": {
		"node": ">=24",
		"pnpm": ">=11"
	},
	"packageManager": "pnpm@11.1.1"
}
