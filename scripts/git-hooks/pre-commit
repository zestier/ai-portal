#!/usr/bin/env bash
# Run the full verification suite before allowing a commit. Mirrors what
# the redeploy button executes, so anything that passes here is safe to
# ship. The verify runner may overlap independent phases, but it still
# requires lint, check, unit, build, and e2e to pass. If this becomes too
# slow, fix the tests — don't add skips.
set -eu

# Allow an explicit escape hatch for emergencies (e.g. mid-rebase fixups).
if [ "${SKIP_VERIFY:-0}" = "1" ]; then
	echo "[pre-commit] SKIP_VERIFY=1 — skipping pnpm run verify"
	exit 0
fi

# Git exports repository-local variables to hooks. In particular,
# GIT_INDEX_FILE=.git/index breaks commands run inside linked worktrees,
# where .git is a file rather than a directory.
while IFS= read -r variable; do
	unset "$variable"
done < <(git rev-parse --local-env-vars)

# Format staged files before verify so prettier --check (inside lint)
# can't block the commit on formatting. Re-stage so committed blobs
# include the formatting. --ignore-unknown makes prettier skip files it
# can't format (binaries, unknown extensions), so no extension filter
# needed; NUL-delimited paths handle spaces.
mapfile -d '' -t files < <(git diff --cached --name-only -z --diff-filter=ACMR)
if ((${#files[@]})); then
	echo "[pre-commit] prettier --write (staged files)"
	pnpm exec prettier --write --ignore-unknown "${files[@]}"
	git add -- "${files[@]}"
fi

echo "[pre-commit] pnpm run verify"
exec pnpm run verify
