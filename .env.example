# Zestier's AI Portal — example env.
# Copy to .env and fill in. Required vars marked with (required).

# --- Server ---
HOST=127.0.0.1
PORT=3000
DATA_DIR=./data
LOG_LEVEL=info

# Default working directory the pi agent operates inside — the real project
# tree the agent reads and edits. Defaults to the server's cwd when unset.
# PROJECT_ROOT=

# Allowlist of roots a user-supplied workdir may resolve inside (comma-separated
# absolute paths). Empty means "only PROJECT_ROOT". Widen it for a single
# trusted operator who points conversations at several project trees. In
# multi-user GitHub mode (AUTH_MODE=github with >1 ALLOWED_GITHUB_LOGINS) the
# effective roots are always clamped to PROJECT_ROOT regardless of this value,
# so one operator can never browse outside it into another's data or host
# secrets via the file-browser / git endpoints.
# ALLOWED_WORKDIRS=

# --- Auth ---
# AUTH_MODE: github | shared-secret | none
AUTH_MODE=none

# Required if AUTH_MODE != none. Generate with: openssl rand -base64 48
SESSION_SECRET=

# Optional. Lifetime of an issued session cookie, in seconds. Default 30 days.
# Shorten for security-sensitive deployments. Existing cookies are not
# invalidated early (they carry their own expiry).
# SESSION_TTL_SECONDS=2592000

# Required. AES-256-GCM key for at-rest token encryption. 32 raw bytes, base64.
# Generate with: openssl rand -base64 32
ENCRYPTION_KEY=

# AUTH_MODE=none safety gate. Each bind address needs its own opt-in:
#   HOST=127.0.0.1 (loopback)       -> set I_KNOW_THIS_IS_LOCAL=1
#   HOST=0.0.0.0   (all interfaces) -> set I_KNOW_THIS_IS_NETWORK_ACCESSIBLE=1
# The network flag is the stronger acknowledgement and stands alone (don't
# also set I_KNOW_THIS_IS_LOCAL). The server refuses to start under
# AUTH_MODE=none if the flag for its HOST is missing. Only bind 0.0.0.0 with
# no auth when reachability is fenced off another way (no published port, a
# private network, or an authenticating reverse proxy / tunnel in front).
I_KNOW_THIS_IS_LOCAL=
I_KNOW_THIS_IS_NETWORK_ACCESSIBLE=

# --- AUTH_MODE=github ---
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
# Comma-separated list of GitHub logins allowed to sign in.
ALLOWED_GITHUB_LOGINS=
# Optional comma-separated subset allowed to run in-app redeploy. Required
# when ENABLE_REDEPLOY=1 and ALLOWED_GITHUB_LOGINS contains multiple logins.
REDEPLOY_ADMIN_GITHUB_LOGINS=

# --- AUTH_MODE=shared-secret ---
SHARED_SECRET=

# Default model for new conversations.
DEFAULT_MODEL=claude-sonnet-4.5
# Model id (`providerId/modelId`) the pi path opens sessions with.
PI_MODEL=anthropic/claude-sonnet-4-5

# --- Durable memory extraction ---
# How durable memories are harvested from each turn.
# MEMORY_EXTRACTOR_BACKEND:
#   heuristic                 — local, no network (default)
#   openai-compatible         — single-shot: model returns one JSON patch
#   openai-compatible-tools   — tool-calling background agent that stores
#                               memory by calling the memory tools; its work
#                               is shown as a subagent card in the chat
# The two model backends require an OpenAI-compatible endpoint + a model
# (MEMORY_EXTRACTOR_MODEL, or a per-conversation extractor model). If either is
# missing the server logs `memory.extractor.fallback_heuristic` and uses the
# heuristic extractor.
#
# Generic OpenAI-compatible /v1 endpoint serving the memory extractor's model.
OPENAI_COMPATIBLE_BASE_URL=
OPENAI_COMPATIBLE_API_KEY=
MEMORY_EXTRACTOR_BACKEND=heuristic
MEMORY_EXTRACTOR_MODEL=
MEMORY_EXTRACTOR_TIMEOUT_MS=20000
MEMORY_EXTRACTOR_MAX_INPUT_CHARS=12000
# Max tool-calling iterations for the openai-compatible-tools extractor.
MEMORY_EXTRACTOR_MAX_TOOL_ITERATIONS=6
# Overall wall-clock budget (ms) for the openai-compatible-tools extractor loop.
# Bounds the whole loop, not just a single request, so it can't hold the turn
# open for maxToolIterations × MEMORY_EXTRACTOR_TIMEOUT_MS in the worst case.
MEMORY_EXTRACTOR_MAX_WALLCLOCK_MS=60000

# --- Adversarial approval mode, Phase 0 (shadow measurement) -----------------
# EXPERIMENTAL, off by default. A second model reviews each prompt-worthy
# permission request and records what it *would* have decided, next to what the
# human actually clicked, so adversary-deny precision/recall can be measured
# before the idea is ever allowed to gate anything. It has NO authority: it
# cannot allow, deny, or delay a request, and a failure changes nothing.
#
# Setting a model is what turns it on — there is deliberately no separate
# on/off flag for the two to disagree about. This is the SERVER-WIDE default;
# it is overridden per user (Settings → General) and per conversation, and a
# conversation column left unset (NULL) resolves to this value.
#
# The reviewer is skipped for any conversation running the same model on the
# same backend, since shared weights mean shared blind spots.
ADVERSARY_SHADOW_MODEL=
# Which backend serves the reviewer. Empty = the conversation's OWN backend,
# which is usually what you want: reviewer independence is a property of the
# model's weights, not of which endpoint serves them, and your chat backend
# already receives every tool call and its arguments — so reviewing them there
# adds no new data-egress destination. Set this only to route the reviewer
# somewhere else (e.g. `openai-compatible` for a local model). Overridden per
# user and per conversation, like the model above.
ADVERSARY_SHADOW_BACKEND=
ADVERSARY_SHADOW_TIMEOUT_MS=20000
ADVERSARY_SHADOW_MAX_ARG_CHARS=4000
# Ceiling on simultaneous in-flight reviewer calls. Matters most in
# `auto-approve` conversations, where no dialog paces the requests. Requests
# over the cap are recorded as explicit skips rather than dropped.
ADVERSARY_SHADOW_MAX_IN_FLIGHT=4

# --- Limits ---
IDLE_TIMEOUT_MIN=15
MAX_CONCURRENT_SESSIONS=4

# --- Operations ---
# Enables POST /api/admin/redeploy under `pnpm run serve`.
ENABLE_REDEPLOY=

# --- Docker Compose (compose.yaml / compose.tunnel.yaml) ---
# Host project tree mounted into the container at /workspace (required).
# PROJECT_DIR=/home/me/projects/foo
# Where the published port binds, and which host port to publish.
# PORTAL_BIND=127.0.0.1
# PORTAL_PORT=3000
# Resource caps so a runaway redeploy/agent session can't OOM the host.
# PORTAL_MEM_LIMIT=2g
# PORTAL_CPUS=2
# Cloudflare Tunnel overlay token (required for compose.tunnel.yaml).
# CLOUDFLARE_TUNNEL_TOKEN=
# CLOUDFLARED_MEM_LIMIT=256m
# CLOUDFLARED_CPUS=1
