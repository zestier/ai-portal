# Zestier's AI Portal — example env.
# Copy to .env and fill in. Required vars marked with (required).

# --- Server ---
HOST=127.0.0.1
PORT=3000
DATA_DIR=./data
LOG_LEVEL=info

# Default working directory the pi agent operates inside — the real project
# tree the agent reads and edits. Defaults to the server's cwd when unset.
# PROJECT_ROOT=

# Allowlist of roots a user-supplied workdir may resolve inside (comma-separated
# absolute paths). Empty means "only PROJECT_ROOT". Widen it for a single
# trusted operator who points conversations at several project trees.
# ALLOWED_WORKDIRS=

# --- No auth layer ---
# The app has NO authentication. There is a single shared local user. Bind
# loopback (the default) and put a real security layer in front (e.g. a
# Tailscale tailnet) if you need remote access — do NOT expose the port
# publicly as-is. See docs/auth-and-security.md.
#
# AES-256-GCM key for encrypting provider/BYOK API secrets at rest in the DB.
# 32 raw bytes, base64. Generate with: openssl rand -base64 32
ENCRYPTION_KEY=

# Bind-address safety gate. Each address needs its own opt-in:
#   HOST=127.0.0.1 (loopback)       -> set I_KNOW_THIS_IS_LOCAL=1
#   HOST=0.0.0.0   (all interfaces) -> set I_KNOW_THIS_IS_NETWORK_ACCESSIBLE=1
# The network flag is the stronger acknowledgement and stands alone (don't
# also set I_KNOW_THIS_IS_LOCAL). The server refuses to start if the flag for
# its HOST is missing — this is what stops you from accidentally exposing a
# no-auth app. Only bind 0.0.0.0 when reachability is fenced off another way
# (no published port, a private network, or an authenticating reverse proxy /
# Tailscale in front), never for direct public exposure.
I_KNOW_THIS_IS_LOCAL=
I_KNOW_THIS_IS_NETWORK_ACCESSIBLE=

# Default model for new conversations.
DEFAULT_MODEL=claude-sonnet-4.5
# Model id (`providerId/modelId`) the pi path opens sessions with.
PI_MODEL=anthropic/claude-sonnet-4-5

# --- Durable memory extraction ---
# How durable memories are harvested from each turn.
# MEMORY_EXTRACTOR_BACKEND:
#   heuristic              — local, no network (default)
#   providerId/modelId     — model-backed extraction: a tool-calling background
#                            agent that stores memory by calling the memory
#                            tools; its work is shown as a subagent card in the
#                            chat (e.g. `anthropic/claude-sonnet-4-5`)
# The model-backed selection is resolved against the configured pi providers. A
# per-conversation extractor model overrides this. An unresolvable selection
# logs `memory.extractor.fallback_heuristic` and uses the heuristic extractor.
MEMORY_EXTRACTOR_BACKEND=heuristic
MEMORY_EXTRACTOR_TIMEOUT_MS=20000
MEMORY_EXTRACTOR_MAX_INPUT_CHARS=12000
# Max tool-calling iterations for the model-backed extractor.
MEMORY_EXTRACTOR_MAX_TOOL_ITERATIONS=6
# Overall wall-clock budget (ms) for the model-backed extractor loop.
# Bounds the whole loop, not just a single request, so it can't hold the turn
# open for maxToolIterations × MEMORY_EXTRACTOR_TIMEOUT_MS in the worst case.
MEMORY_EXTRACTOR_MAX_WALLCLOCK_MS=60000

# --- Adversarial approval mode, Phase 0 (shadow measurement) -----------------
# EXPERIMENTAL, off by default. A second model reviews each prompt-worthy
# permission request and records what it *would* have decided, next to what the
# human actually clicked, so adversary-deny precision/recall can be measured
# before the idea is ever allowed to gate anything. It has NO authority: it
# cannot allow, deny, or delay a request, and a failure changes nothing.
#
# Setting a model selection is what turns it on — there is deliberately no
# separate on/off flag for the two to disagree about. This is the SERVER-WIDE
# default; it is overridden per user (Settings → General) and per conversation,
# and a conversation column left unset (NULL) resolves to this value.
#
# The reviewer is skipped for any conversation running the same model on the
# same selection, since shared weights mean shared blind spots.
ADVERSARY_SHADOW_BACKEND=
# A pi model selection (`providerId/modelId`, e.g. `anthropic/claude-sonnet-4-5`),
# resolved against the configured pi providers. Empty (the default) leaves the
# shadow off. Unresolvable selections record the review as a failed call, never
# a verdict.
ADVERSARY_SHADOW_TIMEOUT_MS=20000
ADVERSARY_SHADOW_MAX_ARG_CHARS=4000
# Ceiling on simultaneous in-flight reviewer calls. Matters most in
# `auto-approve` conversations, where no dialog paces the requests. Requests
# over the cap are recorded as explicit skips rather than dropped.
ADVERSARY_SHADOW_MAX_IN_FLIGHT=4

# --- Limits ---
IDLE_TIMEOUT_MIN=15
MAX_CONCURRENT_SESSIONS=4

# --- Operations ---
# Enables POST /api/admin/redeploy under `pnpm run serve`.
ENABLE_REDEPLOY=

# --- Docker Compose (compose.yaml) ---
# Host project tree mounted into the container at /workspace (required).
# PROJECT_DIR=/home/me/projects/foo
# Where the published port binds, and which host port to publish. Keep the
# loopback default — the container has no auth, so only port-forward it to a
# Tailscale node (or a private network), never publicly.
# PORTAL_BIND=127.0.0.1
# PORTAL_PORT=3000
# Resource caps so a runaway redeploy/agent session can't OOM the host.
# PORTAL_MEM_LIMIT=2g
# PORTAL_CPUS=2
